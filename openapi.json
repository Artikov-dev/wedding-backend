{
  "openapi": "3.0.0",
  "info": {
    "title": "Wedding Hall Booking API",
    "version": "1.0.0",
    "description": "Production-grade wedding hall booking backend API documentation.",
    "contact": {
      "name": "Backend Team",
      "email": "support@example.com"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": ["object", "array", "string", "number", "boolean", "null"] },
          "message": { "type": "string" },
          "error": { "type": "string" },
          "statusCode": { "type": "integer" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["email", "phone", "password", "firstName", "lastName"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" },
          "password": { "type": "string" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "role": { "type": "string", "enum": ["ADMIN", "HALL_OWNER", "SERVICE_PROVIDER", "CUSTOMER"] }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "email": { "type": "string" },
              "firstName": { "type": "string" },
              "lastName": { "type": "string" },
              "role": { "type": "string" }
            }
          },
          "token": { "type": "string" },
          "refreshToken": { "type": "string" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "uptime": { "type": "number" },
          "database": { "type": "string" },
          "version": { "type": "string" }
        }
      },
      "BookingCreateRequest": {
        "type": "object",
        "required": ["hallId", "eventDate", "eventTime", "numberOfGuests", "totalAmount", "advanceAmount", "finalAmount"],
        "properties": {
          "hallId": { "type": "string" },
          "eventDate": { "type": "string", "format": "date" },
          "eventTime": { "type": "string" },
          "numberOfGuests": { "type": "integer" },
          "notes": { "type": "string" },
          "totalAmount": { "type": "number" },
          "advanceAmount": { "type": "number" },
          "finalAmount": { "type": "number" },
          "serviceProviderIds": { "type": "array", "items": { "type": "string" } }
        }
      },
      "PaymentCreateRequest": {
        "type": "object",
        "required": ["bookingId", "amount", "paymentMethodId"],
        "properties": {
          "bookingId": { "type": "string" },
          "amount": { "type": "number" },
          "paymentMethodId": { "type": "string" },
          "paymentMethod": { "type": "string" }
        }
      },
      "ReviewCreateRequest": {
        "type": "object",
        "required": ["rating"],
        "properties": {
          "bookingId": { "type": "string" },
          "hallId": { "type": "string" },
          "serviceProviderId": { "type": "string" },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "comment": { "type": "string" }
        }
      },
      "ServiceCreateRequest": {
        "type": "object",
        "required": ["name", "serviceType", "pricing"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "serviceType": { "type": "string" },
          "pricing": { "type": "number" }
        }
      },
      "InvitationCreateRequest": {
        "type": "object",
        "required": ["bookingId", "email", "guestCount"],
        "properties": {
          "bookingId": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" },
          "guestCount": { "type": "integer" },
          "message": { "type": "string" }
        }
      },
      "UpdateStatusRequest": {
        "type": "object",
        "properties": {
          "status": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate user",
        "description": "Login with email and password to receive JWT and refresh token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": {
                "email": "user@example.com",
                "password": "Secret123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login succeeded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          },
          "401": { "description": "Invalid credentials" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register new user",
        "description": "Create a customer or provider account and issue tokens.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" },
              "example": {
                "email": "newuser@example.com",
                "phone": "+15551234567",
                "password": "Secret123!",
                "firstName": "Jane",
                "lastName": "Doe",
                "role": "CUSTOMER"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "409": { "description": "User already exists" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "summary": "Refresh authentication token",
        "description": "Use a valid refresh token to obtain a new JWT.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              },
              "example": {
                "refreshToken": "eyJhbGciOiJIUzI1..."
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token refreshed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Invalid refresh token" }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "summary": "Request password reset",
        "description": "Start password reset flow by email.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": { "email": { "type": "string", "format": "email" } }
              },
              "example": { "email": "user@example.com" }
            }
          }
        },
        "responses": {
          "200": { "description": "Reset email sent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "summary": "Reset password",
        "description": "Confirm OTP and set a new password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "otp", "newPassword"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "otp": { "type": "string" },
                  "newPassword": { "type": "string" }
                }
              },
              "example": { "email": "user@example.com", "otp": "123456", "newPassword": "NewSecret123!" }
            }
          }
        },
        "responses": {
          "200": { "description": "Password reset", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "400": { "description": "Validation error" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/api/auth/verify-otp": {
      "post": {
        "summary": "Verify OTP",
        "description": "Validate an email or phone OTP code.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "code"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "code": { "type": "string" }
                }
              },
              "example": { "email": "user@example.com", "code": "123456" }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP verified", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "400": { "description": "Invalid OTP" }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health check",
        "description": "Verify API and database connectivity.",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          },
          "503": { "description": "Database connection failed" }
        }
      }
    },
    "/api/bookings": {
      "get": {
        "summary": "List bookings",
        "description": "Retrieve bookings with pagination and role-aware filtering.",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "paymentStatus", "in": "query", "schema": { "type": "string" } },
          { "name": "startDate", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "endDate", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Bookings retrieved", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/bookings/create": {
      "post": {
        "summary": "Create a booking",
        "description": "Create a new booking and associated service bookings.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BookingCreateRequest" },
              "example": {
                "hallId": "hall_123",
                "eventDate": "2026-12-31",
                "eventTime": "18:00",
                "numberOfGuests": 150,
                "notes": "Wedding ceremony",
                "totalAmount": 15000,
                "advanceAmount": 3750,
                "finalAmount": 11250,
                "serviceProviderIds": ["sp_1", "sp_2"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Booking created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/bookings/{bookingId}": {
      "parameters": [
        { "name": "bookingId", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "summary": "Get booking details",
        "description": "Retrieve a single booking by ID.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Booking details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Booking not found" }
        }
      },
      "put": {
        "summary": "Update booking",
        "description": "Update booking status or details.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string" },
                  "paymentStatus": { "type": "string" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Booking updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Booking not found" }
        }
      },
      "delete": {
        "summary": "Cancel booking",
        "description": "Cancel an existing booking.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Booking cancelled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Booking not found" }
        }
      }
    },
    "/api/chat/conversations": {
      "get": {
        "summary": "List conversations",
        "description": "Retrieve chat conversations for the authenticated user.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Conversations list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create or fetch conversation",
        "description": "Start a new chat conversation when one does not already exist.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["participantId"],
                "properties": {
                  "participantId": { "type": "string" }
                }
              },
              "example": { "participantId": "user_456" }
            }
          }
        },
        "responses": {
          "200": { "description": "Conversation created or returned", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/chat/conversations/{conversationId}": {
      "parameters": [
        { "name": "conversationId", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "summary": "Get conversation messages",
        "description": "Retrieve messages for a single conversation.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Conversation messages", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Conversation not found" }
        }
      }
    },
    "/api/chat/messages": {
      "post": {
        "summary": "Send chat message",
        "description": "Post a message into an existing chat conversation.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["conversationId", "content"],
                "properties": {
                  "conversationId": { "type": "string" },
                  "content": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Message sent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/favorites": {
      "get": {
        "summary": "List favorites",
        "description": "Retrieve the authenticated user's favorite halls.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Favorites list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "post": {
        "summary": "Add favorite",
        "description": "Mark a hall as favored by the authenticated user.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["hallId"],
                "properties": { "hallId": { "type": "string" } }
              },
              "example": { "hallId": "hall_123" }
            }
          }
        },
        "responses": {
          "201": { "description": "Favorite added", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/favorites/{hallId}": {
      "parameters": [
        { "name": "hallId", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "delete": {
        "summary": "Remove favorite",
        "description": "Delete a hall from the authenticated user's favorites.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Favorite removed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/halls/search": {
      "get": {
        "summary": "Search halls",
        "description": "Search halls by city, capacity, price, rating, and category.",
        "parameters": [
          { "name": "city", "in": "query", "schema": { "type": "string" } },
          { "name": "capacity", "in": "query", "schema": { "type": "integer" } },
          { "name": "minPrice", "in": "query", "schema": { "type": "number" } },
          { "name": "maxPrice", "in": "query", "schema": { "type": "number" } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "rating", "in": "query", "schema": { "type": "number" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": { "description": "Search results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/halls/create": {
      "post": {
        "summary": "Create hall profile",
        "description": "Create a new hall listing for a hall owner.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "description", "capacity", "pricePerPlate"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "category": { "type": "string" },
                  "capacity": { "type": "integer" },
                  "pricePerPlate": { "type": "number" },
                  "imageUrl": { "type": "string" }
                }
              },
              "example": {
                "name": "Ocean View Hall",
                "description": "A luxury seaside ballroom.",
                "capacity": 250,
                "pricePerPlate": 75.0
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Hall created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/halls/{hallId}": {
      "parameters": [ { "name": "hallId", "in": "path", "required": true, "schema": { "type": "string" } } ],
      "get": {
        "summary": "Get hall profile",
        "description": "Fetch the hall profile by ID.",
        "responses": {
          "200": { "description": "Hall profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "404": { "description": "Hall not found" }
        }
      },
      "put": {
        "summary": "Update hall profile",
        "description": "Update hall details as the hall owner.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "capacity": { "type": "integer" },
                  "pricePerPlate": { "type": "number" },
                  "imageUrl": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Hall updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "delete": {
        "summary": "Delete hall profile",
        "description": "Remove a hall listing.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Hall deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/halls/{hallId}/amenities": {
      "parameters": [ { "name": "hallId", "in": "path", "required": true, "schema": { "type": "string" } } ],
      "get": {
        "summary": "List hall amenities",
        "description": "Get amenities for a specific hall.",
        "responses": {
          "200": { "description": "Amenities returned", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "post": {
        "summary": "Add an amenity",
        "description": "Create a new amenity for the hall.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" }
                }
              },
              "example": { "name": "Parking", "description": "Free onsite parking" }
            }
          }
        },
        "responses": {
          "201": { "description": "Amenity created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/invitations": {
      "get": {
        "summary": "List invitations",
        "description": "Retrieve invitations for the logged-in user.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Invitations list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/invitations/create": {
      "post": {
        "summary": "Create an invitation",
        "description": "Invite a guest to a booking.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InvitationCreateRequest" },
              "example": { "bookingId": "booking_123", "email": "guest@example.com", "phone": "+15551234567", "guestCount": 2, "message": "Please join our wedding" }
            }
          }
        },
        "responses": {
          "201": { "description": "Invitation created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/invitations/{invitationId}": {
